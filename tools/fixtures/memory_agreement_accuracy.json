        {
          "Filler": 3
        },
        {
          "Id": "lake-revision",
          "Player": "挪后一天吧。",
          "Npc": "行，就按这个时间。"
        },
        {
          "Filler": 80
        }
      ],
      "Query": "湖边的约定是什么时候？",
      "GroundTruth": [
        {
          "Id": "lake-day",
          "Statement": "约定后来明确比原定时间推迟一天。原话中的“明天”没有已知说话日期，当前会话缓存并不保证同日，不能把它重新锚定到当前日期并断言是今天的明天或后天；具体日期和钟点都没有得到确认。",
          "Sources": [
            "lake-original-player",
            "lake-original-npc",
            "lake-revision-player",
            "lake-revision-npc"
          ],
          "Status": "current"
        }
      ],
      "Criteria": [
        {
          "Id": "uses-revised-day",
          "PassCondition": "保留“比原定时间推迟一天”这一最新变更。可以只说明相对改期，或询问原约日期；不得把原计划当成没有改期的有效安排。",
          "Sources": [
            "lake-revision-player"
          ],
          "FailureExamples": [
            "还是按最初约定的那天见，不改了。"
          ],
          "Severity": "critical"
        },
        {
          "Id": "does-not-reanchor-old-relative-day",
          "PassCondition": "不得把旧原话“明天”的说话日期当作当前日期，进而断言今天的明天、后天或具体月日。允许说明是“当时所说的明天再推迟一天”，并在需要时确认原约日期。",
          "Sources": [
            "lake-original-player",
            "lake-original-npc",
            "lake-revision-player"
          ],
          "FailureExamples": [
            "那就是后天，也就是夏季17日。",
            "我们明天见吧。"
          ],
          "Severity": "critical"
        },
        {
          "Id": "does-not-invent-clock-time",
          "PassCondition": "不得补充几点、时长或约定中没有的物品。",
          "Sources": [
            "lake-original-player",
            "lake-revision-player"
          ],
          "FailureExamples": [
            "我们就下午两点在湖边待半小时。"
          ],
          "Severity": "critical"
        }
      ],
      "RequiredEvidence": [
        "lake-original-player",
        "lake-revision-player"
      ]
    },
